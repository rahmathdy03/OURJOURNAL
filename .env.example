# App
NEXT_PUBLIC_APP_NAME=Personal Hub
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Needed for verified WhatsApp webhook / admin jobs.
SUPABASE_SECRET_KEY=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=v23.0

# Kebab Finka PWA push notifications
# Generate a key pair with: node scripts/generate-vapid.mjs
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:email-kamu@example.com
CRON_SECRET=

# Google Drive OAuth for Skripsi uploads (server-only)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=https://ourjournal-omega.vercel.app/api/google-drive/callback
# 32 random bytes encoded as base64url. Keep this secret and stable after users connect Drive.
GOOGLE_DRIVE_TOKEN_KEY=

# OJ AI (server-only Gemini key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
